# Painel de licencas Zunder Optimizer
# Copie para .env e preencha (local) ou configure como variaveis no Railway.

# Senha de administrador do painel (use uma forte!)
ADMIN_PASSWORD=troque-esta-senha

# Segredo para assinar o cookie de sessao (qualquer string longa e aleatoria)
SESSION_SECRET=coloque-uma-string-aleatoria-longa-aqui

# Chave privada ECDSA P-256 (PKCS8, base64). NUNCA compartilhe.
# Esta e a chave que assina as licencas - a mesma do keygen local.
LICENSE_PRIVATE_KEY=COLE_AQUI_A_CHAVE_PRIVADA

# Pasta de dados (no Railway aponte para o volume: /data)
DATA_DIR=./data

# Porta (o Railway define automaticamente)
# PORT=3000
